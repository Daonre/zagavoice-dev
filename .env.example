# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vapi (dashboard.vapi.ai -> API Keys)
VAPI_API_KEY=your-vapi-private-key

# Any random secret string. Set the SAME value in Vapi assistant
# "Server URL Secret" so the webhook can verify calls are really from Vapi.
VAPI_WEBHOOK_SECRET=pick-a-long-random-string
